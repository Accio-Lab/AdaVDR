MODEL=/path/to/model
MEDIA_ROOT=/path/to/videos
CUDA_VISIBLE_DEVICES=0
PORT=8000
INPUT_FILE=/path/to/benchmark.parquet
VIDEO_DIR=/path/to/videos
OUTPUT_FILE=/path/to/results/predictions.jsonl

# Keep real endpoints, model names and keys in a private YAML outside this folder.
# Without this variable the loader checks ../.local/services.yaml.
# VDR_SERVICES_CONFIG=/path/to/private/services.yaml

# CACHE_ROOT=/path/to/your/cache
